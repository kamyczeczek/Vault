# Workspace root is versioned (D6). Projects keep their own repos and are
# NOT nested here — the root tracks governance only, never project source.
projects/*/

# PyTorch compilation cache residue
torchinductor_*

__pycache__/
*.pyc
*.pyo

# Local scratch
*.tmp
*.log
.DS_Store
Thumbs.db

# scripts/_scratch/: session debris and one-shot helpers never get committed.
# Two helpers ARE declared tooling (AGENTS.md cites them) — keep them tracked.
scripts/_scratch/*
!scripts/_scratch/patch_lines.py
!scripts/_scratch/run_and_rc.sh

# library/: content-addressed raw source documents; bytes never committed (gate contract in check_workspace_integrity.py ALLOWED_ROOT)
library/

# Click-generated context packs (ctx_*.bat outputs — derived, never committed)
scripts/out/

# Editor state
# .pi/ is the pi coding-agent harness working dir (empty settings.json); declared in CLAUDE.md, never tracked
.pi/
pi-bolt/
.vscode/
.idea/

# Forge runtime state; policy.yaml remains versioned, runtime telemetry is regenerated
.forge/context.md
.forge/state.json
.forge/journal/
.forge/progress/

# agents/: the registry docs (REGISTRY.md, RESTORE.md, backup-agents.ps1) are
# tracked; agents/backup/ holds snapshot zips that copy live agent configs and
# auth (credentials) — never committed, and .gitignore keeps it out of `git status`.
agents/backup/

# tools/: derived outputs (precedents.db, scars.jsonl, briefs) — rebuilt, never committed
tools/out/

# Runtime artifacts
brain/brain.db
brain/*.bak-*
logs/
handoff/audit/

# Commit-approval token: minted by scripts/close.py right before its own commit,
# consumed by scripts/commit_gate_guard.py from hooks/pre-commit. Declared in
# ALLOWED_ROOT (check_workspace_integrity.py) and CLAUDE.md so R1 passes while
# the token exists; never committed.
.commit-approved

# Smart Connections vector index & runtime data (version config only)
.smart-env/*
!.smart-env/smart_env.json

# Obsidian per-device state (changes on every open, never merge)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json

# handoff/state_description/: bridge export from the pre-ICM layout, produced by
# the one-off scripts/oneoff/move_state_description.py. 32 MB of txt dumps, fully
# derived — the live state views are STATE.md and HANDOFF.md. Never committed.
handoff/state_description/

# Runtime memory queries
scripts/memory/queries.jsonl
handoff/session-6-briefs/
scripts/memory/*.db

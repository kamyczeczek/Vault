# --- Per-machine editor state: never content --------------------------------
# ADR-008: anchored patterns follow the knowledge layer into kb/, because a
# pattern containing a slash is resolved against this file's directory.
kb/.obsidian/workspace.json
kb/.obsidian/workspace-mobile.json
kb/.obsidian/cache/
kb/.obsidian/graph.json
.trash/
# Per-plugin scan cache (rebuildable), not settings.
kb/.obsidian/plugins/*/scan-cache.json
# One-off Obsidian repair/disable backups taken during the 2026-10-25 migration.
kb/.obsidian/repair-backup-*/
kb/.obsidian/plugins.disabled-*/
kb/.obsidian/*.bak-*
# obsidian-git writes this passphrase helper at plugin init on every install.
kb/.obsidian/plugins/obsidian-git/obsidian_askpass.sh
# Obsidian auto-recreates this empty folder index; canonical slices live in _slices/
kb/Notes/OKF-rag/source-slices/index.md

# --- Toolchain: installed, never authored -----------------------------------
# 36 766 files / 1 041 MB of third-party code. `pip install` / `npm ci` rebuild
# it; the pyproject.toml / lockfiles that pin it are tracked instead.
__pycache__/
*.pyc
**/.venv/
**/.venv-*/
**/node_modules/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/

# --- Secrets: must never reach this remote (the repo is public) -------------
# A live OPENAI_API_KEY (sk-nry-…) sits in these files today, and the cline
# agent-data dumps carry a secrets.json. Excluded by pattern, not by luck.
**/.env
**/.env.*
!**/.env.example
**/secrets.json
# 24 agent-data zips (13.6 MB) plus the secrets.json above: dumps, not sources.
agents/backup/

# --- Generated in place: rerunning the producer is the source of truth ------
scripts/_scratch/
scripts/out/
tools/out/
.export/
# CodeGraph index: machine-local, rebuilt by `codegraph init` (~70 MB SQLite).
.codegraph/
# unlazy skill session state: locks, approvals, hook state — runtime, never authored.
.unlazy/
# Derived FTS5/brain sidecars: rebuilt from sources, churn on every ingest.
brain/*.db*
# Derived Smart Connections index: machine-local vectors, one tracked config.
kb/.smart-env/*
!kb/.smart-env/smart_env.json
# --- GitHub's hard limit: any file > 100 MB is rejected outright ------------
# Both are derived graphs, regenerable from the corpus next to them.
projects/research/knowledge-retrieval/pilots/graphrag/fixtures/graph_vec.db
projects/research/brain/.brain/graph/graph.db
projects/_archive/agentic-research-lab/knowledge/graph/graph.db

# --- Transient commit-authorization token (minted fresh per commit, 300s TTL)
.commit-approved

# Normalize line endings on checkin; keep LF in the repository. Every project
# repo in this workspace hit the CRLF warning during the split, and the root
# should not reintroduce it.
* text=auto eol=lf

*.md   text diff=markdown
*.py   text diff=python
*.yml  text
*.yaml text
*.json text
*.txt  text

# cmd.exe needs CRLF: with eol=lf it eats the first byte of every line
# ("'chcp' is not recognized"). Blob stays LF-normalized; checkout is CRLF.
scripts/raw_sessions_drive.bat text eol=crlf
scripts/raw_sessions.bat       text eol=crlf
scripts/session_brief.bat      text eol=crlf
scripts/session_digest.bat     text eol=crlf

# Binary: never touched
*.db   binary
*.png  binary
*.jpg  binary
*.pdf  binary
